      "/opt/homebrew/Cellar/libffi",
      "/opt/homebrew/Cellar/libnghttp2",
      "/opt/homebrew/Cellar/libuv",
      "/opt/homebrew/Cellar/llhttp",
      "/opt/homebrew/Cellar/lz4",
      "/opt/homebrew/Cellar/merve",
      "/opt/homebrew/Cellar/nbytes",
      "/opt/homebrew/Cellar/node",
      "/opt/homebrew/Cellar/openssl@4",
      "/opt/homebrew/Cellar/readline",
      "/opt/homebrew/Cellar/simdjson",
      "/opt/homebrew/Cellar/simdutf",
