// srt-agent group "lib/php-common": libraries every Homebrew PHP version loads.
// A building block: the lang/php* groups extend it; projects extend those instead.
{
  "filesystem": {
    "allowRead": [
      "/opt/homebrew/Cellar/aom",
      "/opt/homebrew/Cellar/apr",
      "/opt/homebrew/Cellar/apr-util",
      "/opt/homebrew/Cellar/argon2",
      "/opt/homebrew/Cellar/autoconf",
      "/opt/homebrew/Cellar/brotli",
      "/opt/homebrew/Cellar/ca-certificates",
      "/opt/homebrew/Cellar/curl",
      "/opt/homebrew/Cellar/dav1d",
      "/opt/homebrew/Cellar/fontconfig",
      "/opt/homebrew/Cellar/freetds",
      "/opt/homebrew/Cellar/freetype",
      "/opt/homebrew/Cellar/gd",
      "/opt/homebrew/Cellar/gettext",
      "/opt/homebrew/Cellar/giflib",
      "/opt/homebrew/Cellar/gmp",
      "/opt/homebrew/Cellar/icu4c@79",
      "/opt/homebrew/Cellar/jpeg-turbo",
      "/opt/homebrew/Cellar/json-c",
      "/opt/homebrew/Cellar/krb5",
      "/opt/homebrew/Cellar/libavif",
      "/opt/homebrew/Cellar/libnghttp2",
      "/opt/homebrew/Cellar/libnghttp3",
      "/opt/homebrew/Cellar/libngtcp2",
      "/opt/homebrew/Cellar/libpng",
      "/opt/homebrew/Cellar/libpq",
      "/opt/homebrew/Cellar/libpsl",
      "/opt/homebrew/Cellar/libsodium",
      "/opt/homebrew/Cellar/libssh2",
      "/opt/homebrew/Cellar/libtiff",
      "/opt/homebrew/Cellar/libtool",
      "/opt/homebrew/Cellar/libunistring",
      "/opt/homebrew/Cellar/libvmaf",
      "/opt/homebrew/Cellar/libzip",
      "/opt/homebrew/Cellar/lz4",
      "/opt/homebrew/Cellar/m4",
      "/opt/homebrew/Cellar/oniguruma",
      "/opt/homebrew/Cellar/openldap",
      "/opt/homebrew/Cellar/openssl@4",
      "/opt/homebrew/Cellar/pcre2",
      "/opt/homebrew/Cellar/readline",
      "/opt/homebrew/Cellar/sqlite",
      "/opt/homebrew/Cellar/tidy-html5",
