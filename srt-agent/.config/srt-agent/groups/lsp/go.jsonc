// srt-agent:tools gopls
{
  "filesystem": {
    "allowRead": [
      "/Users/joyce/go/bin/gopls",
    ],
  },
  // Not in a standard PATH folder: added so agents (and language-server
  // plugins) find it by name. Everything in these folders becomes readable.
  "path": ["/Users/joyce/go/bin"],
}
