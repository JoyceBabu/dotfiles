import hashlib
import json
import os
import pwd
from pathlib import Path
import re
import shlex
import shutil
import stat
import subprocess
import sys
import tempfile


OPENAI_DOMAINS = [
    "chatgpt.com", "*.chatgpt.com", "openai.com", "*.openai.com",
    "*.oaistatic.com", "*.oaiusercontent.com",
]
# Built-in agent profiles. homeEnv paths are relative to the private HOME.
# passEnv names the host variables this agent documents for its own use.
AGENTS = {
    "claude": {
        "binary": "claude",
        "homeEnv": {"CLAUDE_CONFIG_DIR": ".claude"},
        "allowedDomains": [],
        "passEnv": ["ANTHROPIC_*", "CLAUDE_CODE_*", "DISABLE_*"],
        "setEnv": {},
        "messaging": True,
