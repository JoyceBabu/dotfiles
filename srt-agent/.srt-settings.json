{
  "allowPty": true,
  "enableWeakerNestedSandbox": false,
  "enableWeakerNetworkIsolation": false,
  "allowAppleEvents": false,
  "network": {
    "allowLocalBinding": false,
    "allowedDomains": [],
    "deniedDomains": [],
    "allowUnixSockets": [
      "/private/var/run/mDNSResponder"
    ],
    "allowMachLookup": [
      "com.apple.trustd.agent",
      "com.apple.pasteboard.1",
      "com.apple.dnssd.service",
      "com.apple.SystemConfiguration.DNSConfiguration",
      "com.apple.SystemConfiguration.configd"
    ]
  },
  "filesystem": {
    "denyRead": [
      "/",
      "~"
    ],
    "allowRead": [
      "/bin",
      "/sbin",
      "/usr",
      "/etc",
      "/private/etc",
      "/private/var/db/timezone",
      "/private/var/run/mDNSResponder",
      "/private/var/run/resolv.conf",
      "/private/var/select",
      "/dev/fd",
      "/dev/null",
      "/dev/random",
      "/dev/tty",
      "/dev/urandom",
      "/dev/zero",
      "/System/Library",
      "/System/Cryptexes/OS",
      "/Library/Developer",
      "/Library/Frameworks",
      "/usr/local/bin",
      "/usr/local/sbin",
      "/opt/homebrew/bin",
      "/opt/homebrew/sbin",
      "/opt/homebrew/opt",
      "/opt/homebrew/Frameworks",
      "/opt/homebrew/etc/openssl@4",
      "/opt/homebrew/etc/ca-certificates",
      "/opt/homebrew/etc/gitconfig",
      "~/.gitconfig",
      "~/.gitignore_global",
      "~/.gitmessage",
      "~/.agents",
      "~/.config/workmux",
      "~/.local/state/workmux",
      "/opt/homebrew/Cellar/pi-coding-agent/"
    ],
    "allowWrite": [
      "~/.local/state/workmux"
    ],
    "denyWrite": [
      "~/.srt-settings.json",
      "~/.dotfiles"
    ]
  }
}
